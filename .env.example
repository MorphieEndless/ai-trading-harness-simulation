# ============================================================================
#  AI Trading Harness — 配置
#  复制成 .env 后填写。.env 权限必须是 600，且永不提交到任何仓库。
#  Agent 看不到这个文件内容（它是 env_file 注入的进程环境变量，
#  而 Agent 执行命令时环境被 env -i 清空）。
# ============================================================================

# ---------------------------------------------------------------------------
# 【必填】你的模型接入点（OpenAI 兼容 + 支持 tool calling）
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://your-endpoint.example.com/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=your-model-name
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# 单次心跳里最多允许的「思考-调工具」轮数，防止跑飞烧钱
LLM_MAX_STEPS_PER_BEAT=12
LLM_TIMEOUT=180
# 单个工具结果最多回灌多少字符。这是成本控制的主要旋钮：
# agent 循环每一步都会重发全部历史，所以工具输出越啰嗦，成本是平方级上涨的。
MAX_TOOL_RESULT_CHARS=2000

# ---------------------------------------------------------------------------
# 搜索 MCP（Exa 托管端点，匿名可用，有速率限制）
# 想解除限制就在 URL 后加 &exaApiKey=你的key
# ---------------------------------------------------------------------------
EXA_MCP_URL=https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa

# ---------------------------------------------------------------------------
# 子代理：把「上下文重、判断轻」的活儿外包给便宜模型
#
#   ★ 用哪个模型由人类在 config/subagent_models.json 里决定（白名单）。
#     主 Agent 只能从白名单里挑，且每个模型的 use_for/avoid_for 会写进工具描述，
#     让它是"看懂差别后选择"而不是瞎猜。改完立即生效，不用重启。
#
#   ★ 白名单文件里【不放密钥】，只放密钥所在的环境变量名。
#     所以那个文件可以公开可读；密钥只在这里（.env）出现。
#
#   用 set-subagent.sh 管理：
#       bash set-subagent.sh --list                 查看白名单
#       bash set-subagent.sh --interim              灌入三个实测可用的便宜模型
#       bash set-subagent.sh --add <id> <base_url> [api_key_env] [max_tokens]
#       bash set-subagent.sh --remove <id>
#       bash set-subagent.sh --default deepseek-v4.1-flash
#       bash set-subagent.sh --off                  清空（delegate 不再暴露）
# ---------------------------------------------------------------------------
SUBAGENT_MODELS_FILE=/app/config/subagent_models.json

# 全局兜底密钥。留空则依次回落到 LLM_API_KEY（同端点时够用）。
# 接独立端点的模型（例如 MiniMax）时，另起一个变量名，然后在白名单条目里
# 用 api_key_env 指向它，例如：
#     SUBAGENT_API_KEY_MINIMAX=sk-xxxxx
SUBAGENT_API_KEY=

SUBAGENT_TEMPERATURE=0.2
SUBAGENT_MAX_TOKENS=8192
# 子代理单次任务最多允许几轮「思考-调工具」
SUBAGENT_MAX_STEPS=8
SUBAGENT_TIMEOUT=120
# 子代理回传给主 Agent 的结论长度上限（这个值直接决定省了多少上下文）
SUBAGENT_MAX_RESULT_CHARS=1500
# 同时最多跑几个子代理。主 Agent 在一轮里可以并发派发多个 delegate 调用。
SUBAGENT_MAX_CONCURRENCY=3
# 单轮心跳里最多派发几次（成本护栏，与并发数是两个不同的轴）
SUBAGENT_MAX_PER_BEAT=8

# ---------------------------------------------------------------------------
# 运行时成本提醒
#   一轮心跳里「自己取数」（行情 market__* / 联网搜索 exa__*）的次数超过这个值、
#   且本轮还没用过子代理时，harness 会往那条取数结果的末尾追加一行
#   「本轮你已经自己取了N次 + 还剩哪些标的没看」，劝它改用 delegate。
#   不新增消息，零兼容风险。
#
#   ★ 口径是「取数次数」，不是「工具调用总数」。曾经用总数，结果读笔记/写笔记/
#     打权益点这些躲不掉的琐务把阈值撑满，提醒每轮空响，Agent 直接学会无视它。
#   设太小会变得聒噪；3 与提示词里「同类取数到第 3 次就停手」这条纪律对齐。
# ---------------------------------------------------------------------------
COST_NUDGE_AFTER=3

# ---------------------------------------------------------------------------
# 人格 / 角色扮演
#   人类的地盘。内容会注入到系统提示词里，决定说话方式与"人味"。
#   改完立即生效，不用重启。留空 = 不加人格层。
#   用 set-persona.sh 管理：  --show / --clear / --example A / --file <路径>
# ---------------------------------------------------------------------------
PERSONA_FILE=/app/config/persona.md

# ---------------------------------------------------------------------------
# 叙事层（可选）—— 把干巴的心跳日志重写成 HalluAct 自己写的记录
#
#   ★ 它是单向的：读事件流 → 吐事件流。输出永远不会回到操盘上下文，
#     所以它配多贵的模型、写多长，都不影响任何一笔交易决策。
#     唯一的调用点在 agent.py 的 _narrate()，返回值直接交给 bus.emit。
#
#   什么时候会写？两条触发，满足任一条就写：
#     A. 有事        —— 成交 / 被风控拒绝 / Operator 留言 / 报错，立刻写
#     B. 太久没说了  —— 距上次叙事超过 NARRATOR_MAX_GAP 秒
#
#   B 不是"兜底"，它就是内容本身：长时间不开仓，**为什么不开仓**同样值得记。
#   震荡行情里 Agent 可以一整天不动，那时候的日志不该是一片空白。
#
#   素材范围是"自上次叙事以来的全部事件"，所以定时触发时它会写成一段回顾，
#   而不是流水账。基准：6 小时 ≈ 一天 4 篇。
# ---------------------------------------------------------------------------
NARRATOR_ENABLED=false

# 无事时最长憋多久写一篇（秒）。6 小时 = 一天四篇左右。
# 设 0 = 每轮都写（约 96 篇/天，很费，只适合短期围观）。
NARRATOR_MAX_GAP=21600

# 不给端点就回落主 LLM（但会用下面这组独立的温度和长度）。
#
# ⛔ 硬规矩：**别用 deepseek-v4.1-flash 写任何文字类产出。**
#    它文笔很差、文科很差。写总结 / 角色日记 / 叙事 / 复盘，一概不许交给它。
#    同一份素材对比过，它写出来是"合规报告"那个味道。当工具用没问题，当笔用不行。
#    这里原来就写着"想省钱可以单开一个便宜的模型"——那句话把人坑了，现在删掉。
#    叙事层是唯一给人类看的东西，一天才 4 篇，省在这里等于把唯一有阅读价值的
#    部分换掉。用主模型那种级别的。
NARRATOR_BASE_URL=
NARRATOR_API_KEY=
# 用思考型模型（Gemini Thinking / o 系 / R1 系）时，下面这个数必须给够 ——
# 因为 reasoning token 也算进 max_tokens。实测：max_tokens=2000 时某思考模型
# 思考吃掉 1922，正文只写了 94 字就被 finish_reason=length 截断。
# journal.md 是 append-only 的，截断的日志会一辈子待在账本里。
NARRATOR_MODEL=Gemini-3.8-Flash-Thinking/Antigravity
NARRATOR_TEMPERATURE=0.85
NARRATOR_MAX_TOKENS=8192
NARRATOR_TIMEOUT=300

# 每篇的长度区间（字）。注意这是「整篇」的上限，聚合窗口跨多轮时也是这个数。
NARRATOR_MIN_CHARS=150
NARRATOR_MAX_CHARS=600

# 人物志：关系、经历、脾气……随便写，只给叙事层看。
# 操盘层看到的仍然只有 persona.md 那两百多字。
NARRATOR_CHARACTER_FILE=/app/config/character.md

# 手账落点。刻意放在 logs 而不是 workspace ——
# 工作区是 Agent 自己 fs_read 得到的地方，放手账等于把叙事喂回操盘上下文。
# 这个文件也是跨重启恢复叙事节奏的依据（重启不会立刻又写一篇）。
NARRATOR_JOURNAL_FILE=/data/logs/journal.md
# 把手账末尾多少字符喂给叙事模型（保持语气连续性）。0 = 完全不喂。
NARRATOR_JOURNAL_EXCERPT=1200

# ---------------------------------------------------------------------------
# 交易参数
# ---------------------------------------------------------------------------
INITIAL_CASH=10000
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT

# ⚠️ 这里原来有一个 HEARTBEAT_SECONDS。2026-09-27 删掉了 ——
# 调度器早就不读它（唤醒节奏的唯一判据是 /data/logs/wake_policy.json，
# 面板上可改），但它一直留在 .env 里、状态接口还报它，看起来像个还能拧的旋钮，
# 其实线路早断了。唤醒的真实语义是「最长沉默」：距上次*任何类型*的唤醒
# 超过 interval 秒就必定醒一次 —— 期间有人类阈值或自唤醒发生，那次兜底就跳过了。
# 详见 wake.py 顶部。

# --- 睡眠配额（mcp-paper 强制，Agent 改不到）---
# 这三个数直接决定它每天最多能跑多少轮心跳，也就是成本上限。
# 睡眠期间定时唤醒全部静默 —— 省 token 主要靠这个。
SLEEP_MIN_HOURS_PER_DAY=6.5
SLEEP_MAX_SINGLE_HOURS=11
SLEEP_MAX_AWAKE_HOURS=17.5
# 留空 = 7x24 不停。填 0-23 的小时区间，如 8-23
ACTIVE_HOURS=

# ---------------------------------------------------------------------------
# 风控（在模拟盘容器内强制执行，Agent 无法绕过）
# ---------------------------------------------------------------------------
RISK_MAX_POSITIONS=5
RISK_MAX_POSITION_PCT=0.25
RISK_MAX_DAILY_LOSS_PCT=0.06
RISK_MIN_NOTIONAL=20
RISK_FEE_BPS=10
RISK_SLIPPAGE_BPS=5

# ---------------------------------------------------------------------------
# Agent 能力开关
# ---------------------------------------------------------------------------
# 允许 Agent 在大脑容器内执行 shell。
#
# run_shell 的子进程带两层真东西，都跟提示词无关：
#   1. 环境变量白名单（sandbox.child_env）—— `env` 读不到任何 key
#   2. Landlock 文件系统规则 —— 只有工作区、/tmp、系统只读目录在名单里，
#      其余一律 EACCES，包括 /data/logs（叙事层手账）和 /proc
#      （/proc/<pid>/environ 里是 brain 的初始环境块，明文密钥）。
#      另外 brain 进程启动时会设 non-dumpable，把 /proc 那条路也焊上。
#
# 沙箱模式：
#   auto    用得上就用；挂不上则降级执行，并在工具返回值里留一行警告（默认）
#   require 挂不上就拒绝执行（最严；内核 < 5.13 时 run_shell 会直接不可用）
#   off     完全关掉（应急用；只在排查"是不是沙箱把命令掐死了"时开）
ENABLE_SHELL=true
SHELL_TIMEOUT=30
SHELL_SANDBOX=auto

# ---------------------------------------------------------------------------
# WebUI 登录（同时也是 nginx 的 Basic Auth）
#
# ⚠️ 两个都留空 = 整个面板对所有人开放（中间件直接放行，这是老行为，故意保留）。
#    想让"公开日志"这件事只发生在该发生的地方，就别留空。
# ---------------------------------------------------------------------------
WEBUI_USER=trader
WEBUI_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------------------------------------------------------------------------
# 公开只读页（2026-09-27）
#
# 无鉴权能看：日志流（思考/工具调用/工具返回/叙事/睡醒）、行情现价、
#             模拟盘账户与成交。
# 无鉴权**看不到**：/api/state（含风控参数）、/api/wake（唤醒策略）、
#             /api/workspace（工作区笔记）、/api/narrator/preview（提示词素材）、
#             以及一切写操作。匿名能碰到的路由只有
#             web.py 里 PUBLIC_ROUTES 那四条，多一条 test_public.py 就会红。
#
# 公开页在 https://<域名>/live 。要整页关掉就把 PUBLIC_LOG_PAGE 设成 false
# （nginx 那边可以不动：应用层会直接 401）。
# ---------------------------------------------------------------------------
PUBLIC_LOG_PAGE=true
# 匿名 SSE 同时最多开几路（**全局**，不是按 IP —— 服务器在 Cloudflare 后面，
# nginx 看到的 remote_addr 是 CF 边缘的 IP，按 IP 限流在公网流量下会失效）。
# 满了返回 503。40 路 ≈ 够几百个偶尔看一眼的访客；要真火起来再调。
PUBLIC_MAX_STREAMS=40
# 公开历史事件一次最多拉多少条（面板自己一次要 150，这里留余量不许无限拉）
PUBLIC_EVENTS_MAX=400
